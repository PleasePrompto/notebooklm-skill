# ── Email Alert Configuration ──────────────────────────────────
# Multiple recipients: separate with commas
ALERT_EMAIL_TO=work@company.com,personal@gmail.com
ALERT_EMAIL_FROM=your-sender@gmail.com
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=your-sender@gmail.com
ALERT_SMTP_PASSWORD=your-gmail-app-password

# For Gmail: generate an App Password at:
#   https://myaccount.google.com/apppasswords
# For Outlook: use smtp-mail.outlook.com port 587
